{
  "expo": {
    "name": "Laudarosii Vertical",
    "slug": "laudarosii-vertical",
    "version": "1.0.1",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "splash": {
      "backgroundColor": "#6366f1"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.laudarosii.vertical",
      "infoPlist": {
        "UIBackgroundModes": [
          "audio"
        ],
        "CFBundleDisplayName": "Vertical București",
        "NSPhotoLibraryUsageDescription": "Aplicația folosește pozele tale pentru a alege o imagine pentru devotional.",
        "ITSAppUsesNonExemptEncryption": false
      },
      "buildNumber": "2"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#6366f1"
      },
      "package": "com.laudarosii.vertical",
      "permissions": [
        "android.permission.MODIFY_AUDIO_SETTINGS"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "single"
    },
    "plugins": [
      "expo-font",
      "expo-secure-store",
      "expo-updates",
      "expo-video",
      [
        "expo-audio",
        {
          "microphonePermission": false
        }
      ],
      "expo-notifications",
      "expo-asset"
    ],
    "owner": "davidpetruttt",
    "extra": {
      "eas": {
        "projectId": "8bfe8882-ed8b-43fd-8bac-c52aad997302"
      }
    },
    "updates": {
      "url": "https://u.expo.dev/8bfe8882-ed8b-43fd-8bac-c52aad997302"
    }
  }
}
