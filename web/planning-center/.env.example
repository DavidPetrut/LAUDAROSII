# Origin-ul backend-ului Vertical (serverul Express care expune /api/pc/v1 + /api/auth).
# Dev local: backend-ul pornește pe portul 3000 (vezi server/index.js).
# Producție: pune aici originul API-ului (ex: https://api.verticalbucuresti.ro) SAU, dacă
# web-ul e servit de pe același host cu API-ul, poți lăsa proxy-ul să nu fie folosit.
PC_API_ORIGIN=http://localhost:3000
